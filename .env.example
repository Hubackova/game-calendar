TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Token pro POST https://hrej.cz/api/v1/images, posila se jako `Authorization: Bearer`.
HREJ_API_TOKEN=

# Klic z https://aistudio.google.com/api-keys pro navrhovani ceskych popisu.
GEMINI_API_KEY=

# 1 = zobrazit redakcni nastroje (porovnani s Hrej, nahrani obalky, zalozeni hry).
VITE_EDITOR_TOOLS=

# Volitelne: jiny ucet na goatcounter.com (kod webu nebo cela adresa
# endpointu), nebo `0` pro vypnuti mereni. Vychozi ucet je ve vite.config.ts.
GOATCOUNTER_SITE=
